{
  "name": "@samline/counter",
  "version": "1.0.0",
  "description": "Count numbers up (or down) as they scroll into view, with easing, decimals and Intl formatting, for vanilla JavaScript, any framework and plain HTML. The final value stays in the HTML.",
  "keywords": [
    "counter",
    "count-up",
    "countup",
    "number",
    "animation",
    "scroll",
    "intersection-observer",
    "intl"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/utils/counter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/utils.git",
    "directory": "packages/counter"
  },
  "bugs": {
    "url": "https://github.com/samline/utils/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/counter.global.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/counter.global.js",
  "jsdelivr": "./dist/browser/counter.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./browser": "./dist/browser/counter.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage"
  },
  "size": {
    "./dist/index.js": 3100,
    "./dist/browser/counter.global.js": 3200
  }
}
