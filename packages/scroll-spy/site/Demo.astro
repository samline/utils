---
// Home preview: a table of contents beside a scrollable article.
const sections = [
  { id: 'spy-demo-intro', title: 'Introduction' },
  { id: 'spy-demo-install', title: 'Installation' },
  { id: 'spy-demo-usage', title: 'Usage' },
  { id: 'spy-demo-options', title: 'Options' },
  { id: 'spy-demo-faq', title: 'FAQ' },
]
---

<scroll-spy-demo class="demo">
  <nav class="toc" aria-label="On this page">
    <p class="toc-title">On this page</p>
    <ul>
      {sections.map(section => (
        <li>
          <a href={`#${section.id}`}>{section.title}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="article" tabindex="0" aria-label="Scrollable article">
    {sections.map((section, i) => (
      <section id={section.id} class:list={['part', { short: i === sections.length - 1 }]}>
        <h3>{section.title}</h3>
        <p>
          {i === sections.length - 1
            ? 'A short last section still becomes active at the bottom.'
            : 'Scroll this box, or pick a link: it stays highlighted while the box scrolls to it.'}
        </p>
      </section>
    ))}
  </div>
</scroll-spy-demo>

<script>
  import { scrollSpy } from '@samline/scroll-spy'

  for (const root of document.querySelectorAll<HTMLElement>('scroll-spy-demo')) {
    const toc = root.querySelector<HTMLElement>('.toc')!
    const article = root.querySelector<HTMLElement>('.article')!
    scrollSpy(toc, { root: article, offset: '30%' })

    // Scroll only the box, not the page, and leave the URL alone.
    toc.addEventListener('click', event => {
      const link = (event.target as Element).closest('a')
      const section = link && root.querySelector<HTMLElement>(link.hash)
      if (!section) return
      event.preventDefault()
      const top =
        article.scrollTop +
        section.getBoundingClientRect().top -
        article.getBoundingClientRect().top -
        16
      article.scrollTo({ top })
    })
  }
</script>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 1rem;
  }
  @media (max-width: 36rem) {
    .demo {
      grid-template-columns: 1fr;
    }
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.125rem;
  }
  .toc-title {
    margin: 0 0 0.5rem;
    font: 0.65rem/1.6 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .toc a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-left: 0.125rem solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }
  .toc a[aria-current] {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  .article {
    height: 16rem;
    overflow-y: auto;
    scroll-behavior: smooth;
    scroll-padding-top: 1rem;
    padding: 0 1rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
  }
  @media (prefers-reduced-motion: reduce) {
    .article {
      scroll-behavior: auto;
    }
  }
  .part {
    min-height: 14rem;
    padding: 1rem 0;
    border-bottom: 0.0625rem solid var(--color-border);
    color: var(--color-text);
  }
  .part.short {
    min-height: 0;
    border-bottom: 0;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .part p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--palette-specimen-text);
  }
</style>
