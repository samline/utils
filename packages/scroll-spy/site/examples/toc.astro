---
import './_shared.css'

const parts = [
  ['overview', 'Overview', '12rem'],
  ['install', 'Install', '12rem'],
  ['usage', 'Usage', '12rem'],
  ['faq', 'FAQ', '4rem'],
] as const
---

<div class="preview scroll-spy-example">
  <div class="layout" data-preview="toc">
    <nav class="side" aria-label="On this page">
      {parts.map(([id, title]) => (
        <a href={`#spy-toc-${id}`}>{title}</a>
      ))}
    </nav>
    <div class="box" tabindex="0" aria-label="Scrollable article">
      {parts.map(([id, title, height]) => (
        <section id={`spy-toc-${id}`} style={`min-height: ${height}`}>
          <p class="part-title">{title}</p>
        </section>
      ))}
    </div>
  </div>
</div>

<script>
  import { scrollSpy } from '@samline/scroll-spy'
  import { scrollInBox } from './_scroll-in-box'

  const layout = document.querySelector('[data-preview="toc"]')!
  const nav = layout.querySelector('nav')!
  const box = layout.querySelector<HTMLElement>('.box')!
  scrollSpy(nav, { root: box })
  scrollInBox(nav, box)
</script>
