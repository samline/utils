{
  "name": "@samline/scroll-to",
  "version": "1.0.0",
  "description": "Smooth scrolling to elements, anchors and positions with offsets for fixed headers, alignment, durations, easing, focus and URL hash handling, for vanilla JavaScript, any framework and plain HTML.",
  "keywords": [
    "scroll-to",
    "smooth-scroll",
    "anchor",
    "scroll",
    "offset",
    "fixed-header",
    "scroll-into-view",
    "skip-link"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/utils/scroll-to/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/utils.git",
    "directory": "packages/scroll-to"
  },
  "bugs": {
    "url": "https://github.com/samline/utils/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/scroll-to.global.js"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/scroll-to.global.js",
  "jsdelivr": "./dist/browser/scroll-to.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./browser": "./dist/browser/scroll-to.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage"
  },
  "size": {
    "./dist/index.js": 2500,
    "./dist/browser/scroll-to.global.js": 2600
  }
}
