---
// Home preview: a page inside a box, with a section that pins while its
// cards cross sideways. The box stands in for the page via `root`.
const cards = [
  ['01', 'Pin', 'The row sticks to the top of the box.'],
  ['02', 'Slide', 'Scrolling down moves it sideways.'],
  ['03', 'Measure', 'The section grows to fit the row.'],
  ['04', 'Focus', 'Tab to a card and the box follows.'],
  ['05', 'Fall back', 'Reduced motion gets a native scroll.'],
  ['06', 'Release', 'At the end, the page carries on.'],
]
---

<horizontal-scroll-demo class="demo">
  <div class="stage" tabindex="0" aria-label="Scrollable page">
    <p class="spacer">Scroll this box ↓</p>
    <section data-horizontal-scroll aria-label="How it works">
      <div data-horizontal-scroll-track class="track">
        {cards.map(([number, title, text]) => (
          <article class="card" tabindex="0">
            <span class="number">{number}</span>
            <strong>{title}</strong>
            <span class="text">{text}</span>
          </article>
        ))}
      </div>
    </section>
    <p class="spacer">The page carries on</p>
  </div>
  <div class="status">
    <span class="meter" aria-hidden="true"><span></span></span>
    <span><output>0%</output> across</span>
  </div>
</horizontal-scroll-demo>

<script>
  import { horizontalScroll } from '@samline/horizontal-scroll'

  for (const root of document.querySelectorAll<HTMLElement>('horizontal-scroll-demo')) {
    const stage = root.querySelector<HTMLElement>('.stage')!
    const output = root.querySelector('output')!
    const meter = root.querySelector<HTMLElement>('.meter')!
    horizontalScroll(root.querySelector('section')!, {
      root: stage,
      onProgress: ({ progress }) => {
        output.value = `${Math.round(progress * 100)}%`
        meter.style.setProperty('--progress', String(progress))
      },
    })
  }
</script>

<style>
  .demo {
    display: grid;
    gap: 0.75rem;
  }
  .stage {
    height: 22rem;
    overflow-y: auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
  }
  .spacer {
    height: 12rem;
    margin: 0;
    display: grid;
    place-items: center;
    font: 0.7rem/1.6 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  /* Without JavaScript or with reduced motion: a native horizontal scroll. */
  [data-horizontal-scroll] {
    overflow-x: auto;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 22rem;
    padding: 0 1rem;
    box-sizing: border-box;
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    flex: 0 0 16rem;
    height: 12rem;
    padding: 1.25rem;
    box-sizing: border-box;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-text);
  }
  .card:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
  .number {
    font: 0.7rem/1.6 var(--font-mono);
    color: var(--color-accent);
  }
  .card strong {
    font-size: 1.25rem;
  }
  .text {
    font-size: 0.875rem;
    color: var(--palette-specimen-text);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font: 0.75rem/1.6 var(--font-mono);
    color: var(--color-text-subtle);
  }
  .meter {
    width: min(12rem, 40%);
    height: 0.1875rem;
    border-radius: 1rem;
    background: var(--color-border);
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }
</style>
