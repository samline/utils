---
import './_shared.css'
---

<div class="preview horizontal-scroll-example">
  <div class="stage" data-preview="responsive" tabindex="0" aria-label="Scrollable page">
    <p class="spacer">Scroll down</p>
    <section
      data-horizontal-scroll
      data-horizontal-scroll-media="(min-width: 48rem)"
      aria-label="Products"
    >
      <div data-horizontal-scroll-track class="track">
        {Array.from({ length: 5 }, (_, i) => <article class="card" tabindex="0">Card {i + 1}</article>)}
      </div>
    </section>
    <p class="spacer">The end</p>
  </div>
  <p class="note">
    State: <output data-state>…</output>.{' '}
    <span data-hint
      >Narrow the window, or turn on reduced motion, to get the swipeable carousel.</span
    >
  </p>
</div>

<script>
  import { horizontalScroll } from '@samline/horizontal-scroll'

  const stage = document.querySelector<HTMLElement>('[data-preview="responsive"]')!
  const section = stage.querySelector('section')!
  const output = document.querySelector<HTMLOutputElement>('[data-preview="responsive"] ~ .note output')!
  horizontalScroll(section, { root: stage })
  const hint = output.parentElement!.querySelector<HTMLElement>('[data-hint]')!
  const show = () => {
    const state = section.getAttribute('data-horizontal-scroll-state') ?? ''
    output.value = state
    // Tell the visitor how to see the other behavior from where they are.
    hint.textContent =
      state === 'active'
        ? 'Narrow the window, or turn on reduced motion, to get the swipeable carousel.'
        : 'Swipe the cards sideways. On a wide screen without reduced motion, scrolling moves them.'
  }
  show()
  new MutationObserver(show).observe(section, {
    attributes: true,
    attributeFilter: ['data-horizontal-scroll-state'],
  })
</script>

<style>
  .preview [data-horizontal-scroll] {
    scroll-snap-type: x mandatory;
  }
  .preview [data-horizontal-scroll] .card {
    scroll-snap-align: center;
    background: color-mix(in srgb, #3fa86b 16%, transparent);
  }
  .preview [data-horizontal-scroll-state='inactive'] .track {
    height: auto;
    padding-block: 2rem;
  }
  .preview [data-horizontal-scroll-state='active'] {
    scroll-snap-type: none;
  }
  .note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
</style>
