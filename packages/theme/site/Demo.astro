---
// Home preview: a small page inside a box with its own theme, storage and
// controls, so the site's theme stays as it is. The log shows each change.
const modes = [
  ['light', 'Light'],
  ['system', 'System'],
  ['dark', 'Dark'],
]
---

<theme-demo class="demo">
  <div class="controls">
    <div class="group" role="group" aria-label="Theme of the preview">
      {modes.map(([value, label]) => (
        <button type="button" data-theme-set={value}>
          {label}
        </button>
      ))}
    </div>
    <button type="button" class="toggle" data-theme-toggle>
      <span aria-hidden="true">◐</span> Toggle
    </button>
  </div>
  <div class="page">
    <div class="bar">
      <strong>Acme</strong>
      <span class="chip">Pricing</span>
    </div>
    <div class="body">
      <p class="part-title">Pick a theme, then reload</p>
      <p>
        The choice is remembered. On System, changing your operating system's appearance updates
        this box live.
      </p>
      <label class="field">
        Native controls follow too
        <input type="range" />
      </label>
    </div>
  </div>
  <p class="status" aria-live="polite">
    <output></output>
  </p>
</theme-demo>

<script>
  import { createTheme, type ThemeState } from '@samline/theme'

  for (const root of document.querySelectorAll<HTMLElement>('theme-demo')) {
    const output = root.querySelector('output')!
    const show = ({ mode, theme }: ThemeState) => (output.value = `mode: ${mode} · theme: ${theme}`)
    const theme = createTheme({
      target: root.querySelector('.page')!,
      scope: root,
      storageKey: 'utils-theme-demo',
      onChange: show,
    })
    show(theme)
  }
</script>

<style>
  .demo {
    display: grid;
    gap: 0.75rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .group {
    display: inline-flex;
    border: 0.0625rem solid var(--color-border);
    border-radius: 999rem;
    overflow: hidden;
  }
  button {
    padding: 0.375rem 0.875rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .toggle {
    border: 0.0625rem solid var(--color-border);
    border-radius: 999rem;
  }
  [aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  /* The page carries its own data-theme, so the site's tokens follow it. */
  .page {
    overflow: hidden;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-bg);
    color: var(--color-text);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 0.0625rem solid var(--color-border);
    font-size: 0.875rem;
  }
  .chip {
    padding: 0.125rem 0.625rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 999rem;
    font-size: 0.75rem;
  }
  .body {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }
  /* Mock headings of the demo content: styled text, so they stay out of the page outline. */
  .body .part-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .body p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  .field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.8125rem;
  }
  .status {
    margin: 0;
    font: 0.75rem/1.6 var(--font-mono);
    color: var(--color-text-subtle);
  }
</style>
