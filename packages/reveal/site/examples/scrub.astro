---
import '../../src/style.css'
import './_shared.css'
---

<div class="preview reveal-example">
  <div class="box" data-preview="scrub" tabindex="0" aria-label="Scrollable scrub effects">
    <p class="spacer">Scroll slowly</p>
    <div class="item" data-reveal="zoom" data-reveal-scrub>
      zoom
    </div>
    <div class="item" data-reveal="left" data-reveal-scrub>
      left
    </div>
    <div class="item" data-reveal="blur" data-reveal-scrub>
      blur
    </div>
    <p class="spacer"></p>
  </div>
  <p class="note" data-support></p>
</div>

<script>
  document.querySelector('[data-support]')!.textContent = CSS.supports('animation-timeline: view()')
    ? 'Scroll-driven animations are supported here.'
    : 'This browser has no scroll-driven animations, so the content stays visible.'
</script>

<style>
  .item {
    --reveal-range: entry 0% cover 40%;
  }
</style>
