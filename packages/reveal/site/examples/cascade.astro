---
import '../../src/style.css'
import './_shared.css'

const items = ['Fast', 'Typed', 'Tiny', 'Accessible', 'Printable', 'Framework-free']
---

<div class="preview">
  <div class="box" data-preview="cascade" tabindex="0" aria-label="Scrollable grid">
    <p class="spacer">Scroll down</p>
    <ul class="grid" data-reveal-stagger="90">
      {items.map(item => (
        <li class="item" data-reveal>
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import { autoReveal } from '@samline/reveal'

  const box = document.querySelector<HTMLElement>('[data-preview="cascade"]')!
  autoReveal({ scope: box, root: box })
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: 0.75rem;
  }
</style>
