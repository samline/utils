---
// Home preview: a scroll box of cards revealed with the chosen effect.
import '../src/style.css'

const effects = ['up', 'down', 'left', 'right', 'fade', 'zoom', 'blur'] as const
const cards = Array.from({ length: 24 }, (_, i) => `Card ${String(i + 1).padStart(2, '0')}`)
---

<reveal-demo class="demo">
  <div class="controls">
    <fieldset class="effects">
      <legend>Effect</legend>
      {effects.map((effect, i) => (
        <label>
          <input type="radio" name="reveal-demo-effect" value={effect} checked={i === 0} />
          <span>{effect}</span>
        </label>
      ))}
    </fieldset>
    <label class="repeat">
      <input type="checkbox" data-repeat />
      <span>Repeat on every entry</span>
    </label>
  </div>
  <div class="scroller" tabindex="0" aria-label="Scrollable cards">
    {cards.map(name => (
      <div class="card" data-reveal="up">
        {name}
      </div>
    ))}
  </div>
  <p class="hint">Scroll the box. Cards that start in view are never hidden.</p>
</reveal-demo>

<script>
  import { reveal, type RevealEffect } from '@samline/reveal'

  for (const root of document.querySelectorAll<HTMLElement>('reveal-demo')) {
    const scroller = root.querySelector<HTMLElement>('.scroller')!
    const cards = scroller.querySelectorAll<HTMLElement>('[data-reveal]')
    const repeat = root.querySelector<HTMLInputElement>('[data-repeat]')!
    let stop = () => {}

    const start = () => {
      stop()
      const effect = root.querySelector<HTMLInputElement>('[name="reveal-demo-effect"]:checked')!
        .value as RevealEffect
      cards.forEach(card => card.setAttribute('data-reveal', effect))
      scroller.scrollTop = 0
      stop = reveal(cards, { root: scroller, stagger: 70, repeat: repeat.checked })
    }

    root.addEventListener('change', start)
    start()
  }
</script>

<style>
  .demo {
    display: grid;
    gap: 0.75rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }
  .effects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    float: left;
    margin-right: 0.5rem;
    font-size: 0.875rem;
    line-height: 2rem;
    color: var(--palette-specimen-text);
  }
  .effects label {
    position: relative;
  }
  .effects input {
    position: absolute;
    opacity: 0;
  }
  .effects span {
    display: block;
    padding: 0.25rem 0.75rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    font: 0.8125rem/1.5rem var(--font-mono);
    color: var(--color-text-subtle);
    cursor: pointer;
  }
  .effects input:checked + span {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  .effects input:focus-visible + span {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.125rem;
  }
  .repeat {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--palette-specimen-text);
  }
  .scroller {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    height: 16rem;
    overflow-y: auto;
    padding: 1rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
  }
  .card {
    display: grid;
    place-items: center;
    min-height: 6.5rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-bg-soft);
    font: 0.8125rem var(--font-mono);
    color: var(--color-text);
  }
  .hint {
    margin: 0;
    font-size: 0.875rem;
    color: var(--palette-specimen-text);
  }
</style>
