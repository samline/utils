{
  "name": "@samline/reveal",
  "version": "1.0.0",
  "description": "Reveal elements once as they scroll into view, with CSS effects, stagger, repeat and a CSS-only scrub mode, for vanilla JavaScript, any framework and plain HTML.",
  "keywords": [
    "reveal",
    "scroll",
    "animation",
    "intersection-observer",
    "fade-in",
    "scroll-driven-animations",
    "aos"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/utils/reveal/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/utils.git",
    "directory": "packages/reveal"
  },
  "bugs": {
    "url": "https://github.com/samline/utils/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/browser/reveal.global.js",
    "./dist/style.css",
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "unpkg": "./dist/browser/reveal.global.js",
  "jsdelivr": "./dist/browser/reveal.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./browser": "./dist/browser/reveal.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage"
  },
  "size": {
    "./dist/index.js": 3100,
    "./dist/browser/reveal.global.js": 3200
  }
}
