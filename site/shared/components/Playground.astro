---
import type { HTMLAttributes } from 'astro/types'
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import DemoFooter from './DemoFooter.astro'
import Button from './Button.astro'
import Field from './Field.astro'
import Select from './Select.astro'
import Disclosure from './Disclosure.astro'
import DemoCode from './DemoCode.astro'
import t, {
  scenarios,
  homePresets,
  type DemoPreset,
  type Scenario,
} from '../i18n/translations/en/demo'
import * as behaviors from '../lib/demo-behavior.js'
interface Props extends HTMLAttributes<'div'> {
  preset?: DemoPreset
  showCode?: boolean
  /** False inside a parent DemoStudio, such as Home's scenario tabs. */
  framed?: boolean
}
const {
  id = `demo-${crypto.randomUUID()}`,
  preset = homePresets[0],
  showCode = false,
  framed = true,
  class: className,
  ...attributes
} = Astro.props
const item: Scenario = scenarios[preset]
const field = item.field
const choice = item.choice
// Render the initial result at build time so the preview is complete without
// JavaScript and does not shift when the script takes over.
const initial: Record<string, string> = behaviors[item.behavior](field.value, choice?.initial ?? '')
const Frame = framed ? DemoStudio : 'div'
---

<div {...attributes} data-ui class:list={['playground', className]}>
  <package-site-demo data-preset={preset} role="group" aria-labelledby={`${id}-label`}>
    <Frame>
      <DemoPanel label={item.tab} tagline={t.previewTagline}>
        <div class:list={['specimen']}>
          <div class:list={['field-column']}>
            <p id={`${id}-label`} class:list={['sr-only']}>
              {item.title}
            </p>
            {item.call && <code class:list={['signature']}>{item.call}</code>}
            {choice && (
              <Select
                id={`${id}-${choice.id}`}
                label={choice.label}
                options={choice.choices}
                value={choice.initial}
                data-choice
              />
            )}
            <Field
              id={`${id}-${field.id}`}
              label={field.label}
              value={field.value}
              placeholder={field.placeholder}
              inputmode={field.inputmode}
              autocomplete="off"
              spellcheck="false"
              data-field
            />
            <p class:list={['preview-description']}>{item.description}</p>
          </div>
          <dl class:list={['readout']} aria-live="polite">
            {item.readouts.map(readout => (
              <div>
                <dt>{readout.label}</dt>
                <dd>
                  <output data-readout={readout.id}>{initial[readout.id] ?? t.empty}</output>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </DemoPanel>
      <DemoFooter note={item.hint}>
        <div class:list={['samples']}>
          <span class:list={['samples-label']}>{t.samplesLabel}</span>
          {item.samples.map(sample => (
            <Button
              variant="secondary"
              data-sample={sample.value}
              data-sample-choice={sample.choice}
              disabled
            >
              {sample.label}
            </Button>
          ))}
          <Button variant="secondary" data-reset disabled>
            {t.reset}
          </Button>
        </div>
      </DemoFooter>
      <noscript>
        <p class:list={['noscript']}>{t.noscript}</p>
      </noscript>
    </Frame>
  </package-site-demo>
  {showCode && (
    <Disclosure class:list={['code-disclosure']}>
      <span slot="summary">{t.openCode}</span>
      <div class:list={['code-body']}>
        <DemoCode preset={preset} />
      </div>
    </Disclosure>
  )}
</div>

<script>
  import { mountElements } from '../lib/mount-elements'
  import { scenarios, type DemoPreset, type Scenario } from '../i18n/translations/en/demo'
  import * as behaviors from '../lib/demo-behavior.js'

  mountElements('package-site-demo', element => {
    const item: Scenario | undefined = scenarios[element.dataset.preset as DemoPreset]
    const field = element.querySelector<HTMLInputElement>('[data-field]')
    if (!item || !field) return
    const lifecycle = new AbortController()
    const { signal } = lifecycle
    const select = element.querySelector<HTMLSelectElement>('select[data-choice]')
    const outputs = element.querySelectorAll<HTMLOutputElement>('output[data-readout]')
    const compute = behaviors[item.behavior] as (
      value: string,
      choice: string
    ) => Record<string, string>

    const update = () => {
      const result = compute(field.value, select?.value ?? '')
      for (const output of outputs) output.value = result[output.dataset.readout!] ?? ''
    }

    field.addEventListener('input', update, { signal })
    select?.addEventListener('change', update, { signal })
    const buttons = element.querySelectorAll<HTMLButtonElement>('[data-sample], [data-reset]')
    for (const button of buttons) {
      button.disabled = false
      button.addEventListener(
        'click',
        () => {
          const reset = button.hasAttribute('data-reset')
          field.value = reset ? item.field.value : (button.dataset.sample ?? '')
          const choice = reset ? item.choice?.initial : button.dataset.sampleChoice
          if (select && choice) select.value = choice
          update()
        },
        { signal }
      )
    }
    update()
    return () => {
      lifecycle.abort()
      for (const button of buttons) button.disabled = true
    }
  })
</script>

<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    min-width: 0;
  }
  package-site-demo {
    display: block;
    min-width: 0;
  }
  .specimen {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.75rem;
    align-items: start;
    min-height: 15rem;
  }
  .field-column {
    display: grid;
    gap: 0.875rem;
    min-width: 0;
  }
  .signature {
    justify-self: start;
    max-width: 100%;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--theme-accent-soft);
    color: var(--color-text);
    font: 0.75rem/1.5 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .preview-description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .readout {
    display: grid;
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-bg);
    overflow: hidden;
  }
  .readout > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    min-width: 0;
  }
  .readout > div + div {
    border-top: 0.0625rem solid var(--color-border);
  }
  .readout > div:first-child {
    background: var(--theme-accent-soft);
  }
  .readout dt {
    font: 0.62rem/1.6 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }
  .readout dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .samples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }
  .samples-label {
    font: 0.62rem/1.6 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-right: 0.25rem;
  }
  .noscript {
    padding: 1rem 1.5rem;
    margin: 0;
    font-size: var(--text-small);
  }
  .code-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-sm);
  }
  .code-disclosure {
    margin-top: var(--space-lg);
    padding-block: var(--space-xs);
  }
  @media (width < 48rem) {
    .specimen {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      min-height: 0;
    }
  }
</style>
