---
import type { HTMLAttributes } from 'astro/types'
import { format } from '../i18n/format'
import { getI18n } from '../i18n/utils'
interface Props extends HTMLAttributes<'a'> {
  version?: string
  href?: string
  /** Hide the version badge between 64rem and 75rem, where the landing header is tightest. */
  compactVersion?: boolean
}
const {
  version,
  href = '#top',
  compactVersion = false,
  class: className,
  ...attributes
} = Astro.props
const i18n = getI18n(Astro)
// A scoped name may wrap only after its scope (@scope/ + name), never mid-word.
const name = i18n.common.packageName
const slash = name.startsWith('@') ? name.indexOf('/') + 1 : 0
---

<a
  {...attributes}
  href={href}
  class:list={['flex min-w-0 items-center gap-2.5 text-sm font-medium tracking-tight', className]}
  aria-label={format(i18n.common.brandHome, { name: i18n.common.packageName })}
>
  <span class:list={['dot-mark']} aria-hidden="true"></span>
  <span class:list={['logo-name font-mono text-[0.95rem]']}>
    {slash ? name.slice(0, slash) : name}
    {slash > 0 && <wbr />}
    {slash > 0 && name.slice(slash)}
  </span>
  {version && (
    <span
      class:list={[
        'ml-1 hidden rounded-full border-[0.0625rem] border-border bg-surface px-2 py-0.5 font-mono text-[0.65rem] text-text-muted sm:inline-block',
        { 'lg:hidden xl:inline-block': compactVersion },
      ]}
    >
      {format(i18n.common.versionLabel, { version })}
    </span>
  )}
</a>

<style>
  .dot-mark {
    display: inline-block;
    flex: none;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }
  /* Long scoped names (@scope/package) wrap after the scope instead of overflowing at
     320px/200% text; breaking inside a word stays a last resort. */
  .logo-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (width < 37.5rem) {
    .logo-name {
      font-size: 0.8rem;
    }
  }
  @media (width < 23.4375rem) {
    .logo-name {
      font-size: 0.72rem;
    }
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
</style>
