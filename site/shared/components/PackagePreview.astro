---
// Collection mode: one package example — its live preview (rendered by the
// package's site/examples/<id>.astro) above its copyable files.
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import PackageCode from './PackageCode.astro'
import Disclosure from './Disclosure.astro'
import demo from '../i18n/translations/en/demo'
import { previewFor, type PackageExample } from '../lib/package-examples'
interface Props {
  /** Collection package slug; omit in package mode. */
  slug?: string | null
  example: PackageExample
  showCode?: boolean
}
const { slug, example, showCode = true } = Astro.props
const Preview = previewFor(slug, example.id) as any
---

<div
  data-ui
  class:list={['package-preview']}
  data-package-example={`${slug ?? 'site'}/${example.id}`}
>
  <DemoStudio>
    <DemoPanel label={example.tab} tagline={demo.previewTagline}>
      <p class:list={['description']}>{example.description}</p>
      <div class:list={['stage']}>
        <Preview />
      </div>
    </DemoPanel>
  </DemoStudio>
  {showCode && (
    <Disclosure class:list={['code-disclosure']}>
      <span slot="summary">{demo.openCode}</span>
      <div class:list={['code-body']}>
        <PackageCode slug={slug} example={example} />
      </div>
    </Disclosure>
  )}
</div>

<style>
  .package-preview {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
  }
  .description {
    margin-block: 0 var(--space-lg);
    color: var(--palette-specimen-text);
    font-size: var(--text-small);
    line-height: 1.75;
  }
  .stage {
    min-width: 0;
  }
  .code-disclosure {
    padding-block: var(--space-xs);
  }
  .code-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-sm);
  }
</style>
