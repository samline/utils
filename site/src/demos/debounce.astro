<p>Type fast. Compare how often each handler runs.</p>
<label for="demo-input">Type here</label>
<input id="demo-input" type="text" autocomplete="off" />
<dl class="counts">
  <div><dt>Every event</dt><dd data-count="raw">0</dd></div>
  <div><dt>debounce 300 ms</dt><dd data-count="debounce">0</dd></div>
  <div><dt>throttle 300 ms</dt><dd data-count="throttle">0</dd></div>
</dl>

<style>
  input {
    display: block;
    width: 100%;
    margin-block: 0.25rem 1rem;
    padding: 0.6rem 0.8rem;
    font: inherit;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  .counts div {
    padding: 0.75rem;
    border-radius: 8px;
    background: var(--code-bg);
  }
  dt {
    font-size: 0.875rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font: 700 1.5rem var(--mono);
  }
</style>

<script>
  import { debounce, throttle } from '@samline/debounce'

  const input = document.getElementById('demo-input') as HTMLInputElement
  const counter = (name: string) => {
    const node = document.querySelector(`[data-count="${name}"]`)!
    let count = 0
    return () => {
      node.textContent = String(++count)
    }
  }

  const raw = counter('raw')
  const debounced = debounce(counter('debounce'), 300)
  const throttled = throttle(counter('throttle'), 300)

  input.addEventListener('input', () => {
    raw()
    debounced()
    throttled()
  })
</script>
