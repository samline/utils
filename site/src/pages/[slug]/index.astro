---
import { getCollection, render } from 'astro:content'

import Base from '../../layouts/Base.astro'
import { catalog, withBase } from '../../lib/packages'

export async function getStaticPaths() {
  const readmes = await getCollection('readmes')
  return catalog.flatMap(entry => {
    const readme = readmes.find(doc => doc.id === entry.slug)
    return readme ? [{ params: { slug: entry.slug }, props: { entry, readme } }] : []
  })
}

const { entry, readme } = Astro.props
const { Content } = await render(readme)

const demos = import.meta.glob<{ default: unknown }>('../../demos/*.astro', { eager: true })
const Demo = demos[`../../demos/${entry.slug}.astro`]?.default as any
---

<Base title={entry.title} description={entry.description}>
  <p><a href={withBase()}>← All utilities</a></p>
  <h1>{entry.title}</h1>
  <p class="lead">{entry.description}</p>
  <pre class="install"><code>npm install {entry.npm}</code></pre>
  {
    Demo && (
      <section class="demo" aria-labelledby="demo-title">
        <h2 id="demo-title">Live example</h2>
        <Demo />
      </section>
    )
  }
  <article class="doc">
    <Content />
  </article>
</Base>
