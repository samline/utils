---
import Box from '../../../shared/components/Box.astro'
import Section from '../../../shared/components/Section.astro'
import PageTitle from '../../../shared/components/PageTitle.astro'
import SectionHeading from '../components/SectionHeading.astro'
import HeroBackdrop from '../components/HeroBackdrop.astro'
import Button from '../../../shared/components/Button.astro'
import Playground from '../../../shared/components/Playground.astro'
import TextLink from '../../../shared/components/TextLink.astro'
import { getI18n } from '../i18n/utils'
import { docsHref } from '../lib/docs'
import { project } from '../../../shared/lib/project.mjs'
import { identityFor, packageSlug } from '../../../shared/lib/identity'
import PackagePreview from '../../../shared/components/PackagePreview.astro'
import { examplesFor } from '../../../shared/lib/package-examples'
import { scenarios, presetIds } from '../../../shared/i18n/translations/en/demo'
const t = getI18n(Astro).examples
// Collection mode: a package's examples come from its site/examples.ts.
const slug = packageSlug(Astro)
const packageExamples = slug ? examplesFor(slug) : []
const items = slug
  ? packageExamples.map(example => ({ id: example.id, tab: example.tab, title: example.title }))
  : presetIds.map(key => ({ id: key, tab: scenarios[key].tab, title: scenarios[key].title }))
// Derive navigation columns from the item count so no row is left orphaned
// (6 → 3 columns, 8 → 4); narrow viewports still fall back to 2 and 1.
const count = items.length
const columns = count <= 4 ? count : count % 4 === 0 ? 4 : count % 3 === 0 ? 3 : 4
const identity = identityFor(Astro)
---

<Section spacing="none" aria-labelledby="examples-title" class:list={['gallery-hero']}>
  <HeroBackdrop />
  <Box size="narrow" class:list={['introduction']}>
    <PageTitle
      headingId="examples-title"
      title={t.title}
      accent={t.accent}
      description={t.description}
      eyebrow={t.eyebrow}
      align="center"
    />
    <div class:list={['gallery-actions']}>
      <Button context="hero" href={`#${items[0]?.id ?? ''}`} variant="primary">
        {t.exploreAction}
        <span aria-hidden="true">↓</span>
      </Button>
      <Button context="hero" href={docsHref('setup', Astro)} variant="secondary">
        {t.installAction}
        <span aria-hidden="true">↗</span>
      </Button>
    </div>
    <p class:list={['accessibility']}>{t.accessibility}</p>
  </Box>
  <Box size="medium" class:list={['gallery']}>
    <div class:list={['gallery-index']}>
      <p class:list={['navigation-label']}>{t.navigation}</p>
      <nav
        aria-label={t.navigation}
        class:list={['recipe-navigation']}
        style={`--recipe-columns: ${columns}`}
      >
        {items.map(item => (
          <Button variant="secondary" href={`#${item.id}`} class:list={['recipe-link']}>
            {item.tab}
            <span aria-hidden="true">↓</span>
          </Button>
        ))}
      </nav>
    </div>
    {items.map((item, index) => (
      <section id={item.id} aria-labelledby={`${item.id}-title`} class:list={['recipe']}>
        <SectionHeading
          headingId={`${item.id}-title`}
          eyebrow={`${String(index + 1).padStart(2, '0')} / ${item.tab}`}
          class:list={['recipe-heading']}
        >
          {item.title}
        </SectionHeading>
        {slug ? (
          <PackagePreview slug={slug} example={packageExamples[index]!} />
        ) : (
          <Playground preset={item.id as (typeof presetIds)[number]} showCode />
        )}
      </section>
    ))}
    <div class:list={['resources']}>
      <p class:list={['basis-full', 'text-center', 'text-pretty']}>{t.possibilities}</p>
      <TextLink href={docsHref('examples', Astro)}>{t.guide}</TextLink>
      <TextLink href={`${project.base}skills/${identity.skill}/SKILL.md`} download="SKILL.md">
        {t.skill}
      </TextLink>
    </div>
  </Box>
</Section>

<style>
  .gallery-hero {
    isolation: isolate;
    position: relative;
    padding-top: 3.5rem;
  }
  .introduction {
    text-align: center;
  }
  .gallery-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: 1.875rem;
  }
  .accessibility {
    margin-top: var(--space-lg);
    color: var(--color-text-subtle);
    font-size: var(--text-small);
    line-height: 1.75;
    text-wrap: pretty;
  }
  .gallery {
    padding-block: 3rem 5rem;
  }
  .gallery-index {
    padding-bottom: 3rem;
  }
  .navigation-label {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .recipe-navigation {
    display: grid;
    grid-template-columns: repeat(var(--recipe-columns, 4), minmax(0, 1fr));
    gap: var(--space-sm);
  }
  .recipe-link {
    justify-content: space-between;
    text-align: left;
    padding: 0.75rem 1rem;
  }
  .resources {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg) var(--space-xl);
    padding-top: 3rem;
    border-top: 0.0625rem solid var(--color-border-soft);
  }
  @media (width < 48rem) {
    .gallery-hero {
      padding-top: 3rem;
    }
    .recipe-navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 30rem) {
    .gallery-actions {
      flex-direction: column;
    }
    .recipe-navigation {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .recipe {
    --recipe-top-space: 2.5rem;
    padding-block: var(--recipe-top-space);
    border-top: 0.0625rem solid var(--color-border-soft);
  }
  .recipe[id] {
    scroll-margin-top: calc(var(--header-offset, 9rem) - var(--recipe-top-space) - 0.0625rem);
  }
  .recipe-heading {
    overflow-wrap: anywhere;
    margin-bottom: 2rem;
  }
  @media (width < 48rem) {
    .recipe {
      --recipe-top-space: 2rem;
    }
  }
</style>
