---
// Collection mode Home: every package of the collection, searchable and
// filterable. Without JavaScript the complete catalog stays visible.
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import PageTitle from '../../../shared/components/PageTitle.astro'
import Surface from '../../../shared/components/Surface.astro'
import TextField from '../../../shared/components/TextField.astro'
import Select from '../../../shared/components/Select.astro'
import HeroBackdrop from '../components/HeroBackdrop.astro'
import { getI18n } from '../i18n/utils'
import { format } from '../../../shared/i18n/format'
import { collectionPackages } from '../../../shared/lib/identity'
const t = getI18n(Astro).collection
const packages = collectionPackages
const categories = [...new Set(packages.map(item => item.category))].sort()
const options: (readonly [value: string, label: string])[] = [
  ['', t.allCategories],
  ...categories.map(category => [category, category] as const),
]
---

<Section spacing="none" aria-labelledby="catalog-title" class:list={['catalog-hero']}>
  <HeroBackdrop />
  <Box size="narrow">
    <PageTitle
      headingId="catalog-title"
      title={t.title}
      accent={t.accent}
      description={t.description}
      eyebrow={t.eyebrow}
      align="center"
    />
  </Box>
  <Box size="medium">
    <package-site-catalog id="catalog" class:list={['catalog']}>
      <div class:list={['filters']} role="search">
        <TextField
          id="catalog-search"
          label={t.search}
          type="search"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          data-catalog-search
        />
        <Select
          id="catalog-category"
          label={t.category}
          options={options}
          hideLabel
          data-catalog-category
        />
      </div>
      <p
        class:list={['sr-only']}
        aria-live="polite"
        data-catalog-status
        data-template={t.results}
      ></p>
      <ul class:list={['grid']} data-catalog-list>
        {packages.map(item => (
          <li
            data-category={item.category}
            data-search={[item.name, item.npmName, item.summary, item.category, ...item.tags]
              .join(' ')
              .toLowerCase()}
          >
            <Surface as="article" interactive class:list={['card']}>
              <div class:list={['art']} aria-hidden="true">
                {item.art ? (
                  <Fragment set:html={item.art} />
                ) : (
                  <span class:list={['monogram']}>{item.name.slice(0, 1)}</span>
                )}
              </div>
              <p class:list={['meta']}>
                <span>{item.category}</span>
                {item.size && <span>{item.size}</span>}
              </p>
              <h2 class:list={['name']}>
                <a href={item.home}>{item.name}</a>
              </h2>
              <p class:list={['summary']}>{item.summary}</p>
              <ul
                class:list={['highlights']}
                aria-label={format(t.highlights, { name: item.name })}
              >
                {item.highlights.map(highlight => (
                  <li>{highlight}</li>
                ))}
              </ul>
              <div class:list={['footer']}>
                <code class:list={['npm']}>{item.npmName}</code>
                <p class:list={['links']}>
                  {item.hasExamples && <a href={`${item.home}examples/`}>{t.examples}</a>}
                  <a href={item.docsHome}>{t.docs}</a>
                  <span class:list={['version']}>
                    {format(t.version, { version: item.version })}
                  </span>
                </p>
              </div>
            </Surface>
          </li>
        ))}
      </ul>
      <p class:list={['empty']} hidden data-catalog-empty>
        {t.empty}
      </p>
    </package-site-catalog>
  </Box>
</Section>

<script>
  import { mountElements } from '../../../shared/lib/mount-elements'

  mountElements('package-site-catalog', root => {
    const search = root.querySelector<HTMLInputElement>('[data-catalog-search]')!
    const category = root.querySelector<HTMLSelectElement>('[data-catalog-category]')!
    const items = [...root.querySelectorAll<HTMLElement>('[data-catalog-list] > li')]
    const empty = root.querySelector<HTMLElement>('[data-catalog-empty]')!
    const status = root.querySelector<HTMLElement>('[data-catalog-status]')!
    const apply = () => {
      const query = search.value.trim().toLowerCase()
      let shown = 0
      for (const item of items) {
        const match =
          (!query || item.dataset.search!.includes(query)) &&
          (!category.value || item.dataset.category === category.value)
        item.hidden = !match
        if (match) shown++
      }
      empty.hidden = shown > 0
      status.textContent = status.dataset.template!.replace('{count}', String(shown))
    }
    const controller = new AbortController()
    search.addEventListener('input', apply, { signal: controller.signal })
    category.addEventListener('change', apply, { signal: controller.signal })
    return () => controller.abort()
  })
</script>

<style>
  .catalog-hero {
    isolation: isolate;
    position: relative;
    padding-top: 3.5rem;
    padding-bottom: 6rem;
  }
  /* Like a package Home: the name on top, its phrase on the line below. */
  .catalog-hero :global(.page-title .serif) {
    display: block;
  }
  .catalog {
    display: block;
    margin-top: 2.5rem;
  }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
    align-items: end;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  /* Both controls share one height so they read as a single toolbar. */
  .filters :global(input),
  .filters :global(select) {
    height: 3.25rem;
    min-height: 0;
    padding-block: 0;
  }
  /* Six rows per card on a subgrid, so previews, titles, summaries and
     footers line up across every card of a row. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid > li {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
  }
  .grid > li[hidden] {
    display: none;
  }
  .card {
    position: relative;
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0.75rem;
    padding: 0.75rem 0.75rem var(--space-lg);
    transition:
      border-color var(--duration-ui) var(--ease-ui),
      transform var(--duration-ui) var(--ease-ui);
  }
  .card > :not(.art) {
    margin-inline: 0.75rem;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 240 / 132;
    margin: 0 0 0.25rem;
    border-radius: calc(var(--radius-panel) - 0.375rem);
    background:
      radial-gradient(
        circle at 50% 120%,
        color-mix(in oklab, var(--color-accent) 16%, transparent),
        transparent 70%
      ),
      color-mix(in oklab, var(--color-text) 4%, transparent);
    color: var(--color-text);
    overflow: hidden;
  }
  .art :global(svg) {
    width: 100%;
    height: 100%;
    transition: transform var(--duration-ui) var(--ease-ui);
  }
  /* Art classes for site/card.svg: neutral fills and lines, accent marks and text. */
  .art :global(.f) {
    fill: color-mix(in oklab, currentColor 9%, transparent);
  }
  .art :global(.f2) {
    fill: color-mix(in oklab, currentColor 20%, transparent);
  }
  .art :global(.s) {
    fill: none;
    stroke: color-mix(in oklab, currentColor 30%, transparent);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .art :global(.a) {
    fill: var(--color-accent);
  }
  .art :global(.al) {
    fill: color-mix(in oklab, var(--color-accent) 16%, transparent);
  }
  .art :global(.as) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art :global(.al.as) {
    fill: color-mix(in oklab, var(--color-accent) 16%, transparent);
    stroke-width: 1.5;
  }
  .art :global(.dash) {
    stroke-dasharray: 4 5;
  }
  .art :global(text) {
    fill: var(--color-text-muted);
    font: 500 11px var(--font-mono);
  }
  .art :global(.strong) {
    fill: var(--color-text);
    font-size: 13px;
  }
  .art :global(.accent) {
    fill: var(--color-accent);
  }
  .art :global(.num) {
    font: 600 30px var(--font-sans, inherit);
    letter-spacing: -0.03em;
  }
  .art :global(.ghost) {
    fill: currentColor;
    opacity: 0.18;
    font-size: 22px;
  }
  .monogram {
    color: var(--color-accent);
    font-size: 3rem;
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-block: 0;
    color: var(--color-text-subtle);
    font: 0.65rem/1.6 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .name {
    margin-block: 0;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .name a {
    color: var(--color-text);
    text-decoration: none;
    outline: none;
  }
  /* The title link covers the whole card; the footer links sit above it. */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .card:has(.name a:focus-visible) {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .summary {
    margin-block: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .highlights {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.375rem;
    margin-block: 0;
    padding: 0;
    list-style: none;
  }
  .highlights li {
    padding: 0.125rem 0.5rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 999rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .footer {
    display: grid;
    align-content: end;
    gap: 0.625rem;
    padding-top: 0.875rem;
    border-top: 0.0625rem solid var(--color-border-soft);
  }
  .npm {
    font-size: var(--text-small);
    color: var(--color-text-subtle);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .links a {
    position: relative;
    z-index: 1;
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 60%, transparent);
    text-underline-offset: 0.2em;
  }
  .links a:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
    border-radius: 0.125rem;
  }
  .version {
    margin-left: auto;
    color: var(--color-text-subtle);
    font: 0.7rem var(--font-mono);
  }
  @media (hover: hover) {
    .card:hover {
      border-color: color-mix(in oklab, var(--color-accent) 55%, var(--palette-feature-border));
      transform: translateY(-0.125rem);
    }
    .card:hover .name a {
      color: var(--color-accent);
    }
    .card:hover .art :global(svg) {
      transform: scale(1.04);
    }
    .links a:hover {
      color: var(--color-accent);
    }
  }
  .empty {
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .art :global(svg) {
      transition: none;
    }
    .card:hover,
    .card:hover .art :global(svg) {
      transform: none;
    }
  }
  @media (width < 40rem) {
    .filters {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
